#!/usr/bin/env bash
#
# claude-acct — run Claude Code under a named account.
#
#   claude-acct <account> [claude args...]
#
# Claude Code picks its identity from ambient state: a Keychain login, or an
# OAuth token in the environment. That makes "which account is this session
# on?" awkward to control from an editor, which execs the binary directly and
# never sources a shell. This script makes the account an explicit argument.
#
# Accounts are configured entirely by environment, so no site-specific values
# live in this file. For an account named <ACCOUNT> (upper-cased, '-' as '_'):
#
#   CLAUDE_ACCT_TOKEN_<ACCOUNT>       the OAuth token itself. Checked first.
#   CLAUDE_ACCT_TOKEN_REF_<ACCOUNT>   a 1Password secret reference to read the
#                                     token from, used only if the above is
#                                     unset. Requires the `op' CLI.
#   CLAUDE_ACCT_AMBIENT_<ACCOUNT>     set to declare that this account
#                                     deliberately uses the ambient login
#   CLAUDE_ACCT_CLAUDE_BIN            path to the real claude binary
#   CLAUDE_ACCT_OP_BIN                path to the 1Password CLI, if it is not
#                                     simply `op' on PATH
#
# An account with no token runs under the ambient login, whatever
# `claude /login' last established, and says so on stderr -- because that is
# also what a typo'd account name or an unexported variable looks like, and the
# script cannot tell them apart. Setting CLAUDE_ACCT_AMBIENT_<ACCOUNT> declares
# the intent and silences the notice. So a two-account setup might be:
#
#   export CLAUDE_ACCT_TOKEN_WORK="sk-ant-oat..."          # no 1Password
#   export CLAUDE_ACCT_TOKEN_REF_WORK="op://Vault/id/cred" # or via 1Password
#   export CLAUDE_ACCT_AMBIENT_ME=1
#   claude-acct work   # token-authenticated
#   claude-acct me     # ambient login, quietly
#
# `op' is entirely optional: it is consulted only for accounts configured with
# a _REF and no direct token, so setups without 1Password work unchanged.
#
# Trade-off worth knowing: a direct token sits in the environment for as long
# as it is exported, and is inherited by every child process. Reading through
# `op' instead keeps it out of the environment and makes each session start an
# explicit, prompted authorization. Prefer _REF where that matters; prefer the
# direct token where there is no secret manager, or where repeated prompts are
# not workable (e.g. a tool launching several sessions at once).
#
# Either way the token is exported only into the exec'd process: never written
# to disk, never passed in argv (so it does not appear in `ps'). Note that an
# exported token is still readable from /proc/<pid>/environ by the same user on
# Linux, and that an editor which imports it into its own environment hands it
# to every subprocess it spawns, not just Claude -- see the note on importing
# these variables in .emacs.d/Emacs.org.

set -euo pipefail

CLAUDE_BIN="${CLAUDE_ACCT_CLAUDE_BIN:-$HOME/.local/bin/claude}"

# Which `op' to use, for a 1Password CLI installed somewhere other than PATH --
# and so that the tests can point this at nothing, and exercise the
# missing-op path without depending on where a given platform installs it or
# ever reaching a real secret store.
OP_BIN="${CLAUDE_ACCT_OP_BIN:-op}"

die() { printf 'claude-acct: %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
usage: claude-acct <account> [claude args...]

Runs Claude Code under a named account. The token for <ACCOUNT> is taken from
CLAUDE_ACCT_TOKEN_<ACCOUNT> if set, else read from the 1Password reference in
CLAUDE_ACCT_TOKEN_REF_<ACCOUNT>, else the session uses the ambient login. The
1Password CLI is needed only for the _REF form. ANTHROPIC_API_KEY and
ANTHROPIC_AUTH_TOKEN are cleared for every account, since either would outrank
both and silently change how the session is billed.

With no account argument, prompts when stdin is a terminal. Non-interactive
callers (editors, scripts) must pass the account explicitly, so that they know
which account the session is on.

env:
  CLAUDE_ACCT_TOKEN_<ACCOUNT>       the account's OAuth token (checked first)
  CLAUDE_ACCT_TOKEN_REF_<ACCOUNT>   1Password ref to read it from instead
  CLAUDE_ACCT_AMBIENT_<ACCOUNT>     declare that this account uses the
                                    ambient login, silencing the notice
  CLAUDE_ACCT_CLAUDE_BIN            path to the real claude binary
  CLAUDE_ACCT_OP_BIN                path to the 1Password CLI, if not `op'
EOF
  exit 2
}

account="${1:-}"
case "$account" in
  -h|--help) usage ;;
  # Reject anything option-shaped before it can be taken for an account. Without
  # this, `claude-acct --resume' consumes the flag as the account name, finds no
  # token for it, and execs claude with no arguments under the ambient login --
  # wrong account and wrong command, silently. It also catches the case where a
  # caller's argument order drifts and the account stops being $1.
  -*) die "expected an account name, got the option '${account}'" ;;
  "")
    # Interactive fallback for terminal use only.
    if [ -t 0 ] && [ -t 2 ]; then
      printf 'Account: ' >&2
      read -r account
      [ -n "$account" ] || die "no account given"
      case "$account" in -*) die "expected an account name, got '${account}'" ;; esac
    else
      die "no account given and stdin is not a terminal"
    fi
    ;;
  *) shift ;;
esac

# Account names become part of an environment variable name, so keep them to
# characters that cannot smuggle anything into the lookup. Note that '-' and '_'
# fold together in that name, so "a-b" and "a_b" would share one token variable.
case "$account" in
  *[!A-Za-z0-9_-]*|"") die "invalid account name '${account}'" ;;
esac

[ -x "$CLAUDE_BIN" ] || die "claude binary not executable: $CLAUDE_BIN"

# Guard against this script shadowing the real claude and exec'ing itself.
# The shell fallback keeps this working where neither realpath (not on older
# macOS) nor python3 (needs the Xcode CLT) is present -- without it both sides
# resolve to the empty string, compare equal, and the script dies claiming a
# self-reference that isn't there. That fallback resolves the directory but not
# a symlinked final component, so it can miss a self-reference reached through a
# link; this guard is a check against misconfiguration, not a security control.
resolve() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"
  else
    ( cd "$(dirname -- "$1")" 2>/dev/null || exit 1
      printf '%s/%s\n' "$(pwd -P)" "$(basename -- "$1")" )
  fi
}
self="$(resolve "$0" || true)"
target="$(resolve "$CLAUDE_BIN" || true)"
# Only meaningful if both resolved; a failure here must not masquerade as a match.
if [ -n "$self" ] && [ -n "$target" ] && [ "$self" = "$target" ]; then
  die "CLAUDE_ACCT_CLAUDE_BIN points back at this script; set it to the real claude"
fi

# An API key outranks BOTH an OAuth token and the Keychain login in Claude
# Code's auth precedence, silently changing how the session is billed. Clear it
# for every account, not just token-authenticated ones.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN

# Account name upper-cased, dashes as underscores, for the env lookups.
suffix="$(printf '%s' "$account" | tr '[:lower:]-' '[:upper:]_')"
tok_var="CLAUDE_ACCT_TOKEN_${suffix}"
ref_var="CLAUDE_ACCT_TOKEN_REF_${suffix}"

token="${!tok_var:-}"

if [ -n "$token" ]; then
  : # Token supplied directly; no secret manager needed.
elif [ -n "${!ref_var:-}" ]; then
  command -v "$OP_BIN" >/dev/null 2>&1 || \
    die "1Password CLI not found: '$OP_BIN' (needed for '$account'; set CLAUDE_ACCT_OP_BIN to its path)"
  # Read per invocation: the 1Password prompt is the authorization step that
  # makes each token-authenticated start visible. Set $tok_var instead when
  # that prompt is not wanted (see the header note on the trade-off).
  if ! token="$("$OP_BIN" read "${!ref_var}")"; then
    die "could not read the token for '$account' from 1Password ($ref_var)"
  fi
  [ -n "$token" ] || die "1Password returned an empty token for '$account'"
else
  # Nothing configured for this account. That is a legitimate setup -- it is how
  # an ambient-login account is expressed -- but it is also exactly what a typo'd
  # account name looks like, or a variable that never reached a GUI editor. The
  # script cannot tell those apart, so it says so rather than starting quietly on
  # the wrong account. Declaring the account ambient states the intent and
  # silences the notice.
  amb_var="CLAUDE_ACCT_AMBIENT_${suffix}"
  if [ -z "${!amb_var:-}" ]; then
    printf 'claude-acct: no token configured for %s (%s and %s are unset); using the ambient login. Set %s=1 if that is intended.\n' \
      "$account" "$tok_var" "$ref_var" "$amb_var" >&2
  fi
  exec "$CLAUDE_BIN" "$@"
fi

export CLAUDE_CODE_OAUTH_TOKEN="$token"
unset token
exec "$CLAUDE_BIN" "$@"
